# A-5b の設定。**このファイルをコピーして .env を作る。**
#   cp .env.example .env
# .env は .gitignore で除外されている。**絶対にコミットしない。チャットに貼らない。**

# Slack の Bot トークン（xoxb- で始まる）
# アプリの管理画面「OAuth & Permissions」→「Bot User OAuth Token」
SLACK_BOT_TOKEN=

# Slack のアプリレベルトークン（xapp- で始まる）。Socket Mode の接続に使う
# アプリの管理画面「Basic Information」→「App-Level Tokens」
SLACK_APP_TOKEN=

# Gemini の API キー（A-1 と同じもの）
GEMINI_API_KEY=
