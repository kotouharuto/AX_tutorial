# A-5a の通知設定。**このファイルをコピーして .env を作る。**
#   cp .env.example .env
# .env は .gitignore で除外されている。**絶対にコミットしない。**

# 通知を有効にするか。false の間はメールを送らず、本文を標準出力に出すだけ。
# 既定は false。設定ミスで意図せず送信されるより、送られない方が安全。
NOTIFY_ENABLED=false

# 送信元・宛先
NOTIFY_FROM=
NOTIFY_TO=

# SMTP サーバ
# Gmail の場合：smtp.gmail.com / 587 / STARTTLS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# SMTP のユーザ名（Gmail では送信元アドレスと同じ）
SMTP_USER=

# 【重要】Gmail では通常のログインパスワードは使えない。
# 2段階認証を有効にした上で「アプリパスワード」を発行して貼る。
#   https://myaccount.google.com/apppasswords
# 16文字の英数字。スペースは入れても入れなくてもよい。
SMTP_PASSWORD=
